{
	"name": "obsidian-video-embed",
	"version": "0.2.3",
	"description": "Paste a YouTube, Instagram, or TikTok link and choose to embed it right in your note. Drag to resize, edit, or turn it back into a link.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint main.ts parse.ts paste-prompt.ts",
		"test": "node --experimental-strip-types --test test/*.test.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"youtube",
		"instagram",
		"tiktok",
		"embed"
	],
	"author": "haotiencheng",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"esbuild": "0.17.3",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.2.9",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4",
		"typescript-eslint": "^8.71.2"
	}
}
